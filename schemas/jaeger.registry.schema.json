{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peezy-tech.github.io/jaeger/schemas/jaeger.registry.schema.json",
  "title": "Jaeger module registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "items"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "homepage": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
