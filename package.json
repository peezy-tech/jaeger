{
  "name": "jaeger-workflows",
  "version": "0.1.0",
  "description": "Prompt-first workflows across native agent harnesses",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matamune-peezy/jaeger-workflows.git"
  },
  "homepage": "https://github.com/matamune-peezy/jaeger-workflows#readme",
  "bugs": {
    "url": "https://github.com/matamune-peezy/jaeger-workflows/issues"
  },
  "keywords": [
    "agents",
    "automation",
    "codex",
    "claude-code",
    "orchestration",
    "workflows"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "jaeger": "./dist/cli.js"
  },
  "files": [
    "AGENT_INSTALL.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "dist/",
    "docs/deployment-model.md",
    "docs/design/jaeger-runtime-modules.md",
    "docs/design/jaeger-workflows.md",
    "examples/*.js",
    "examples/*.json",
    "examples/*.toml",
    "examples/environment/",
    "examples/runtime-modules/telegram/README.md",
    "examples/runtime-modules/telegram/jaeger.runtime.mjs",
    "examples/runtime-modules/telegram/package-lock.json",
    "examples/runtime-modules/telegram/package.json",
    "examples/runtime-modules/telegram/telegram.mjs",
    "skills/jaeger-workflows/"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs dist .test-dist",
    "build": "node scripts/clean.mjs dist && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/clean.mjs .test-dist && tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "test:portable": "node scripts/clean.mjs .test-dist && tsc -p tsconfig.test.json && node --test .test-dist/test/compiler.test.js .test-dist/test/environments.test.js .test-dist/test/hooks.test.js .test-dist/test/runtime-durability.test.js .test-dist/test/runtime-modules.test.js .test-dist/test/runtime-view.test.js .test-dist/test/runtime.test.js .test-dist/test/session-turns.test.js .test-dist/test/windows-controller.test.js",
    "test:controller": "node scripts/clean.mjs .test-dist && tsc -p tsconfig.test.json && node --test .test-dist/test/runtime-view.test.js .test-dist/test/windows-controller.test.js",
    "jaeger": "node dist/cli.js",
    "verify": "npm run clean && npm run check && npm test && npm run build && node scripts/verify-package.mjs && git diff --check",
    "verify:portable": "npm run clean && npm run check && npm run test:portable && npm run build && node scripts/verify-controller-package.mjs && git diff --check",
    "verify:controller": "npm run clean && npm run check && npm run test:controller && npm run build && node scripts/verify-controller-package.mjs && git diff --check",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "os": [
    "linux",
    "win32"
  ],
  "packageManager": "pnpm@11.1.3",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.212",
    "ajv": "^8.17.1",
    "smol-toml": "^1.7.0",
    "typescript": "^5.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}
