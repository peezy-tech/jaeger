{
  "$schema": "../../../schemas/jaeger.module.schema.json",
  "schemaVersion": 1,
  "name": "discord",
  "title": "Discord runtime and realtime voice module",
  "description": "Private Discord lifecycle notifications, read-only forked queries, and DAVE-encrypted Codex realtime voice.",
  "files": [
    "README.md",
    "codex-app-server.mjs",
    "discord.mjs",
    "headless-webrtc.mjs",
    "jaeger-readonly-tools.mjs",
    "jaeger.runtime.mjs",
    "media-bridge.mjs",
    "test/codex-app-server.test.mjs",
    "test/discord.test.mjs",
    "test/headless-webrtc.test.mjs",
    "test/jaeger-readonly-tools.test.mjs",
    "test/media-bridge.test.mjs"
  ],
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@node-webrtc-rust/sdk": "^0.6.23",
    "discord.js": "^14.27.0",
    "opusscript": "^0.0.8"
  },
  "requires": {
    "jaeger": ">=0.1.4",
    "node": ">=22.13.0",
    "codex": ">=0.145.0 with realtime_conversation"
  },
  "configuration": [
    {
      "name": "tokenFile",
      "required": true,
      "secret": true,
      "description": "Owner-only file containing the official Discord bot token."
    },
    {
      "name": "guildId",
      "required": true
    },
    {
      "name": "voiceChannelId",
      "required": true
    },
    {
      "name": "allowUserId",
      "required": true
    },
    {
      "name": "notificationChannelId",
      "required": false,
      "description": "Private guild text channel for lifecycle notifications; direct messages are used when omitted."
    },
    {
      "name": "ringingTimeoutMs",
      "required": true
    },
    {
      "name": "silenceTimeoutMs",
      "required": true
    },
    {
      "name": "maximumCallTimeoutMs",
      "required": true
    },
    {
      "name": "operatorStateFile",
      "required": true,
      "secret": true,
      "description": "Owner-only state file containing only the dedicated Codex operator thread ID."
    }
  ],
  "declaredAccess": {
    "network": [
      "discord.com",
      "gateway.discord.gg",
      "configured Discord voice endpoint",
      "OpenAI realtime through codex app-server"
    ],
    "process": [
      "codex app-server",
      "jaeger status"
    ],
    "runtime": [
      "events",
      "runs",
      "sessions",
      "services",
      "storage"
    ]
  },
  "commands": {
    "test": "node --test modules/discord/test/*.test.mjs"
  }
}
