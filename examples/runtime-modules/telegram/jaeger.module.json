{
  "$schema": "../../../schemas/jaeger.module.schema.json",
  "schemaVersion": 1,
  "name": "telegram",
  "title": "Telegram runtime module",
  "description": "Durable Jaeger lifecycle notifications and forked session queries through Telegram.",
  "files": [
    "README.md",
    "jaeger.runtime.mjs",
    "telegram.mjs"
  ],
  "dependencies": {
    "grammy": "^1.38.3"
  },
  "requires": {
    "jaeger": ">=0.1.4",
    "node": ">=22.13.0"
  },
  "configuration": [
    {
      "name": "tokenFile",
      "required": true,
      "secret": true,
      "description": "Private BotFather token file outside the installed module source."
    },
    {
      "name": "allowUserIds",
      "required": true
    },
    {
      "name": "allowChatIds",
      "required": true
    }
  ],
  "declaredAccess": {
    "network": [
      "api.telegram.org"
    ],
    "runtime": [
      "events",
      "sessions",
      "services",
      "storage"
    ]
  }
}
