{
  "$schema": "../../../schemas/jaeger.module.schema.json",
  "schemaVersion": 1,
  "name": "voice-spike",
  "title": "Codex realtime voice compatibility spike",
  "description": "Private general-purpose WebRTC voice surface with generated UI and outbound Telegram call invitation proof.",
  "files": [
    "README.md",
    "call.mjs",
    "codex-app-server.mjs",
    "dynamic-ui-tools.mjs",
    "folder-surface.mjs",
    "jaeger-readonly-tools.mjs",
    "probe.mjs",
    "public/app.js",
    "public/call-access.js",
    "public/favicon.svg",
    "public/index.html",
    "public/styles.css",
    "public/workspace.js",
    "reset.mjs",
    "server.mjs",
    "telegram-call.mjs",
    "ui/workspace.jsx",
    "test/browser-session.test.mjs",
    "test/codex-app-server.test.mjs",
    "test/dynamic-ui-tools.test.mjs",
    "test/folder-surface.test.mjs",
    "test/jaeger-readonly-tools.test.mjs",
    "test/server.test.mjs",
    "test/telegram-call.test.mjs"
  ],
  "dependencies": {},
  "requires": {
    "jaeger": ">=0.1.4",
    "node": ">=22.13.0",
    "codex": "realtime_conversation"
  },
  "configuration": [
    {
      "name": "VOICE_SPIKE_PUBLIC_ORIGIN",
      "required": true
    },
    {
      "name": "VOICE_SPIKE_PUBLIC_URL",
      "required": true,
      "description": "HTTPS URL of this install's own voice surface; Telegram invitation tokens are placed in its fragment"
    },
    {
      "name": "VOICE_SPIKE_CWD",
      "required": false,
      "description": "Working directory for the Codex app-server thread; defaults to the process working directory"
    },
    {
      "name": "VOICE_TELEGRAM_ENV_FILE",
      "required": false,
      "secret": true
    }
  ],
  "declaredAccess": {
    "network": [
      "api.telegram.org",
      "configured HTTPS origin"
    ],
    "process": [
      "codex app-server",
      "jaeger status"
    ]
  },
  "commands": {
    "start": "node modules/voice-spike/server.mjs",
    "call": "node modules/voice-spike/call.mjs",
    "probe": "node modules/voice-spike/probe.mjs",
    "reset": "node modules/voice-spike/reset.mjs",
    "test": "node --test modules/voice-spike/test/*.test.mjs"
  }
}
